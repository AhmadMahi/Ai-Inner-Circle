{"v":1,"dev":"01a077b6-4c36-77bc-879a-5f58767d5cc4","seq":1189,"lc":1189,"ts":1789833888952,"enc":"none","op":"block.set","d":{"pageId":"01a0ba47-8062-73ae-8e5f-d3d4f08eae3c","block":{"absorbedIds":[],"access":null,"content":{"text":"You are assisting an IT operations team in a banking environment.\n\nA customer-facing payment application is experiencing\nintermittent service disruptions.\n\nProvide:\n1. Initial investigation steps.\n2. Key infrastructure metrics to check.\n3. Information to collect before escalation.\n4. A short incident update for stakeholders.\n\nDo not assume the specific root cause.\nDo not suggest production changes without appropriate approval."},"createdAt":1789833887642,"frameId":null,"h":null,"id":"01a0ba69-bf9a-794f-b18e-e8476da2b722","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1789833888227,"w":525.9677734375,"x":72.0,"y":5160.0,"z":138}}}
{"v":1,"dev":"01a077b6-4c36-77bc-879a-5f58767d5cc4","seq":1190,"lc":1190,"ts":1789833890484,"enc":"none","op":"block.set","d":{"pageId":"01a0ba47-8062-73ae-8e5f-d3d4f08eae3c","block":{"absorbedIds":[],"access":null,"content":{"text":"You are assisting an IT operations team in a banking environment.\n\nA customer-facing payment application is experiencing\nintermittent service disruptions.\n\nProvide:\n1. Initial investigation steps.\n2. Key infrastructure metrics to check.\n3. Information to collect before escalation.\n4. A short incident update for stakeholders.\n\nDo not assume the specific root cause.\nDo not suggest production changes without appropriate approval."},"createdAt":1789833887642,"frameId":null,"h":null,"id":"01a0ba69-bf9a-794f-b18e-e8476da2b722","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1789833888227,"w":525.9677734375,"x":96.0,"y":5160.0,"z":138}}}
