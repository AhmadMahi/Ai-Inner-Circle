{"v":1,"dev":"01a077b6-4c36-77bc-879a-5f58767d5cc4","seq":960,"lc":960,"ts":1789832918381,"enc":"none","op":"block.set","d":{"pageId":"01a0ba47-8062-73ae-8e5f-d3d4f08eae3c","block":{"absorbedIds":[],"access":null,"content":{"ink":{"add":[],"base":"4c4355d1aea46329a90958d6a22cf013da85935bdc38f211d108caeb11bee95f","gone":"","n":16,"o":[153.82711369812253,2202.0177414969558],"v":1}},"createdAt":1789832912816,"frameId":null,"h":25.679134243247972,"id":"01a0ba5a-dfb0-7fd6-92c3-82c21fcf33df","placement":"snapped","rotation":0.0,"type":"ink","updatedAt":1789832917666,"w":113.35763031126484,"x":153.82711369812253,"y":2202.0177414969558,"z":60}}}
{"v":1,"dev":"01a077b6-4c36-77bc-879a-5f58767d5cc4","seq":961,"lc":961,"ts":1789832963823,"enc":"none","op":"block.set","d":{"pageId":"01a0ba47-8062-73ae-8e5f-d3d4f08eae3c","block":{"absorbedIds":[],"access":null,"content":{"text":""},"createdAt":1789832963095,"frameId":null,"h":null,"id":"01a0ba5b-a417-749b-89f5-d7bd0aa625f2","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1789832963095,"w":200.0,"x":168.0,"y":2280.0,"z":61}}}
{"v":1,"dev":"01a077b6-4c36-77bc-879a-5f58767d5cc4","seq":962,"lc":962,"ts":1789832964919,"enc":"none","op":"block.set","d":{"pageId":"01a0ba47-8062-73ae-8e5f-d3d4f08eae3c","block":{"absorbedIds":[],"access":null,"content":{"text":"Banking security is how banks protect your money, data, and transactions from theft or fraud. It works on several layers:\n\n- **Authentication** – Proving you are who you say you are (passwords, PINs, biometrics like fingerprints or face ID, two-factor authentication).\n- **Encryption** – Scrambling data so it can’t be read if intercepted (e.g., HTTPS, end-to-end encryption for mobile banking).\n- **Fraud detection** – Monitoring transactions for unusual patterns (e.g., sudden large purchases or foreign activity) and blocking suspicious ones.\n- **Tokenization** – Replacing sensitive card numbers with unique tokens during payments so real details aren’t exposed.\n- **Regulatory compliance** – Following laws like GDPR or PCI-DSS and reporting suspicious activity (AML/KYC checks).\n- **Physical security** – Vaults, cameras, and secure branches for traditional banking.\n\nIn short: it’s a mix of technology, rules, and monitoring to keep your money safe — both in the real world and online."},"createdAt":1789832963095,"frameId":null,"h":null,"id":"01a0ba5b-a417-749b-89f5-d7bd0aa625f2","placement":"snapped","rotation":0.0,"type":"text","updatedAt":1789832964207,"w":640.0,"x":168.0,"y":2280.0,"z":61}}}
